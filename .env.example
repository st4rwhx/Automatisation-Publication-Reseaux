# ===== LLM Configuration =====
# Au moins une clé API LLM doit être configurée
# La chaîne essaie dans cet ordre : Gemini → Groq → DeepSeek → Kimi

# Google Gemini (gratuit, 1500 req/jour)
# Obtenir la clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (gratuit, 30 RPM)
# Obtenir la clé : https://console.groq.com
GROQ_API_KEY=

# DeepSeek
# Obtenir la clé : https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Kimi (Moonshot)
# Obtenir la clé : https://platform.moonshot.cn
KIMI_API_KEY=

# ===== Vidéo (optionnel) =====
# Sans cette clé, le pipeline vidéo est ignoré (repli sur visuel statique).
# Nécessite aussi ffmpeg installé localement (voix off gratuite, sans clé).

# Pexels (gratuit, illimité)
# Obtenir la clé : https://www.pexels.com/api/
PEXELS_API_KEY=

# ===== Postiz Configuration (optionnel) =====
# Requis pour publier sur les réseaux sociaux

# URL de l'API Postiz (ex: http://192.168.x.x:3000)
POSTIZ_API_URL=

# Clé d'authentification Postiz
POSTIZ_API_KEY=

# URL de base des visuels hébergés (ex: https://example.com/assets)
IMAGES_BASE_URL=

# ===== Publication Configuration (optionnel) =====

# Réseaux à exclure (défaut : "x" car payant)
# Format : "x,facebook" ou vide pour tous les réseaux
RESEAUX_EXCLUS=x
