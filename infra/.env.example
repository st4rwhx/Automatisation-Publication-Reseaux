# Copier en infra/.env puis remplir. Ne jamais committer infra/.env.
#
# Générer les secrets :
#   openssl rand -hex 32

# URL publique de Postiz, en HTTPS (obligatoire pour les callbacks OAuth des réseaux).
MAIN_URL=https://social.cematys.fr

JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=

# Passer à "true" une fois ton compte admin créé, pour fermer les inscriptions.
DISABLE_REGISTRATION=false

# === Identifiants des apps développeur.
# Se remplissent au fur et à mesure des validations (voir docs/DEPLOIEMENT.md).
# Un réseau dont les variables sont vides n'apparaît pas dans Postiz.

# LinkedIn — le plus rapide à obtenir.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (Facebook + Instagram). Une seule app couvre les deux.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Cloud / YouTube Data API v3.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok — validation la plus longue.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Threads (app Meta distincte de Facebook).
THREADS_APP_ID=
THREADS_APP_SECRET=

# X / Twitter.
X_API_KEY=
X_API_SECRET=

# Optionnel : laisse Postiz reformuler le texte par plateforme.
OPENAI_API_KEY=
