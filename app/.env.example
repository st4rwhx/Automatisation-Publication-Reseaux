# ===== Base de données =====
# Postgres géré (Supabase recommandé, gratuit jusqu'à 500 Mo) : supabase.com
DATABASE_URL=

# ===== Authentification (Clerk) =====
# clerk.com — plan gratuit jusqu'à 10k utilisateurs actifs/mois
# Active Google OAuth + email/mdp dans le dashboard Clerk (User & Authentication → Social Connections)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ===== Facturation (Stripe) =====
# stripe.com — créer 2 produits récurrents (Starter, Pro) et copier leurs price_id
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ===== Application =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Génération de contenu (mêmes clés que l'automatisation existante) =====
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
PEXELS_API_KEY=

# ===== Publication (Postiz) =====
POSTIZ_API_URL=
POSTIZ_API_KEY=

# ===== Stockage des visuels (Vercel Blob) =====
# vercel.com/dashboard → Storage → Create → Blob. Généré automatiquement si
# le projet est déployé sur Vercel et le store Blob rattaché au projet.
BLOB_READ_WRITE_TOKEN=

# ===== Cron quotidien =====
# Chaîne aléatoire longue (ex: openssl rand -hex 32). Si le nom de la variable
# est exactement CRON_SECRET, Vercel Cron ajoute automatiquement l'en-tête
# Authorization: Bearer <valeur> à ses appels — aucune configuration manuelle
# supplémentaire n'est nécessaire.
CRON_SECRET=
